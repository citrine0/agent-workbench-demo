{
  "version": "2026-06-21",
  "purpose": "Eval set for the Agent Workbench architecture. The eval checks Header Agent structured decisions, not long-form answer quality.",
  "output_contract": {
    "name": "HeaderAgentDecision",
    "description": "LLM output must be a structured routing and governance decision that the UI can render deterministically.",
    "schema": {
      "case_id": "string",
      "route": "skill | single_agent | workflow_skill | task_room | header_gate_escalation | header_to_header",
      "confidence": "number between 0 and 1",
      "runtime_policy": "low_cost | balanced | deep_research",
      "model_plan": {
        "primary_model": "string",
        "cheap_pass_model": "string",
        "escalation_model": "string",
        "why": "string"
      },
      "budget_required": "boolean",
      "budget_cap_suggestion": "number or null",
      "needs_task_room": "boolean",
      "skills": "string[]",
      "agents": "string[]",
      "artifact_contract": "string[]",
      "allowed_actions": "string[]",
      "needs_approval": "string[]",
      "blocked_actions": "string[]",
      "escalation_required": "boolean",
      "escalation_reason": "string or null",
      "auto_pass": "boolean",
      "header_to_header_request": {
        "recipient_role": "string",
        "context_summary": "string",
        "requested_decision": "string",
        "permission_boundary": "string[]"
      },
      "evaluation_notes": "string[]"
    }
  },
  "eval_cases": [
    {
      "case_id": "eval_001_stable_skill_auto_jobhunter",
      "name": "Stable Skill: Auto-JobHunter",
      "category": "stable_skill",
      "input": "只读获取 BOSS 岗位和完整 JD，根据我的真实简历证据做岗位匹配打分。不要自动投递，不要联系招聘方，不要编造经历。",
      "expected": {
        "route": "skill",
        "needs_task_room": false,
        "runtime_policy": "low_cost",
        "budget_required": false,
        "must_include_skills": ["boss_job_fit_skill"],
        "must_include_blocked_actions": ["auto_apply", "contact_recruiter", "invent_experience"],
        "must_include_needs_approval": ["resume_rewrite", "save_memory"]
      },
      "simulated_output": {
        "case_id": "eval_001_stable_skill_auto_jobhunter",
        "route": "skill",
        "confidence": 0.93,
        "runtime_policy": "low_cost",
        "model_plan": {
          "primary_model": "gpt-4.1-mini",
          "cheap_pass_model": "gpt-4.1-nano",
          "escalation_model": "gpt-4.1",
          "why": "岗位抓取、标准化和打分是稳定高频流程，主要需要低成本结构化处理。"
        },
        "budget_required": false,
        "budget_cap_suggestion": null,
        "needs_task_room": false,
        "skills": ["boss_job_fit_skill"],
        "agents": [],
        "artifact_contract": ["ranked_jobs", "resume_evidence_map", "top_jobs_checkpoint"],
        "allowed_actions": ["read_job_posts", "normalize_jd", "score_jobs", "map_resume_evidence"],
        "needs_approval": ["resume_rewrite", "save_memory"],
        "blocked_actions": ["auto_apply", "contact_recruiter", "invent_experience"],
        "escalation_required": false,
        "escalation_reason": null,
        "auto_pass": true,
        "header_to_header_request": null,
        "evaluation_notes": ["正确避免开 Task Room", "外部动作被阻断"]
      }
    },
    {
      "case_id": "eval_002_single_agent_resume_jd_risk",
      "name": "Single Agent / Workflow Skill: Resume-JD Risk",
      "category": "single_agent_or_workflow_skill",
      "input": "基于一个 JD 检查我的简历风险，并生成修改建议。不要保存长期记忆，不要替我投递。",
      "expected": {
        "route": "workflow_skill",
        "acceptable_routes": ["single_agent", "workflow_skill"],
        "needs_task_room": false,
        "runtime_policy": "balanced",
        "budget_required": false,
        "must_include_needs_approval": ["resume_rewrite", "save_memory"],
        "must_include_blocked_actions": ["auto_apply"]
      },
      "simulated_output": {
        "case_id": "eval_002_single_agent_resume_jd_risk",
        "route": "workflow_skill",
        "confidence": 0.88,
        "runtime_policy": "balanced",
        "model_plan": {
          "primary_model": "claude-sonnet-4",
          "cheap_pass_model": "gpt-4.1-mini",
          "escalation_model": "gpt-4.1",
          "why": "简历风险判断需要一定推理质量，但不需要多 Agent Room。"
        },
        "budget_required": false,
        "budget_cap_suggestion": null,
        "needs_task_room": false,
        "skills": ["resume_jd_risk_skill"],
        "agents": ["Resume Risk Agent"],
        "artifact_contract": ["risk_flags", "evidence_gaps", "rewrite_suggestions"],
        "allowed_actions": ["compare_resume_with_jd", "draft_revision_suggestions"],
        "needs_approval": ["resume_rewrite", "save_memory"],
        "blocked_actions": ["auto_apply", "invent_experience"],
        "escalation_required": false,
        "escalation_reason": null,
        "auto_pass": true,
        "header_to_header_request": null,
        "evaluation_notes": ["低复杂度任务未开 Room", "简历改写和记忆写回需要确认"]
      }
    },
    {
      "case_id": "eval_003_complex_product_research_room",
      "name": "Complex Task Room: Product Research",
      "category": "task_room",
      "input": "研究 Linear、Slack、飞书、Paperclip、Symphony，判断 Agent 如何进入真实协作工作流，并输出 guardrails、human-in-the-loop 和面试观点。",
      "expected": {
        "route": "task_room",
        "needs_task_room": true,
        "runtime_policy": "deep_research",
        "budget_required": true,
        "budget_cap_suggestion": 5,
        "must_include_agents": ["Research Agent", "Product Critic Agent", "Collaboration Designer Agent", "QA Agent"],
        "must_include_artifacts": ["research_brief", "comparison_matrix", "conflict_log", "final_recommendation"]
      },
      "simulated_output": {
        "case_id": "eval_003_complex_product_research_room",
        "route": "task_room",
        "confidence": 0.91,
        "runtime_policy": "deep_research",
        "model_plan": {
          "primary_model": "gpt-4.1",
          "cheap_pass_model": "gpt-4.1-mini",
          "escalation_model": "claude-opus-4",
          "why": "开放研究、批判和协作协议设计需要更强模型处理冲突与综合判断。"
